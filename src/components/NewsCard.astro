---
import { url, formatDate } from '../lib/nav';
interface Props { id: string; title: string; date: Date; cover?: string }
const { id, title, date, cover } = Astro.props;
---
<a class="news" href={url(`/novyny/${id}/`)}>
  <div class="news__img">
    {cover ? <img src={cover.startsWith('/') ? url(cover) : cover} alt="" loading="lazy" /> : <span aria-hidden="true">К</span>}
  </div>
  <div class="news__body">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    <h3>{title}</h3>
  </div>
</a>

<style>
  .news { display: grid; gap: 14px; align-content: start; color: inherit; text-decoration: none; min-width: 0; }
  .news__img { aspect-ratio: 16 / 10; border-radius: var(--radius); overflow: hidden; background: var(--grad); display: grid; place-items: center; }
  .news__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  .news:hover .news__img img { transform: scale(1.03); }
  .news__img span { font-size: 48px; font-weight: 800; opacity: .25; }
  .news__body { display: grid; gap: 6px; }
  .news time { font-size: 14px; font-weight: 600; color: var(--violet); font-variant-numeric: tabular-nums; }
  .news h3 { font-size: 18px; line-height: 1.3; font-weight: 600; letter-spacing: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .news:hover h3 { text-decoration: underline; text-underline-offset: 3px; }
</style>
