---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import site from '../data/site.json';
import { url } from '../lib/nav';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const quick = [
  { title: 'Вступ до 1 класу', text: 'Документи, заява і строки зарахування', href: '/batkam/vstup-do-1-klasu/' },
  { title: 'Документи закладу', text: 'Статут, ліцензії, звіти, кошторис', href: '/dokumenty/' },
  { title: 'Адміністрація', text: 'Хто за що відповідає і як зв’язатися', href: '/pro-nas/administratsiia/' },
  { title: 'Протидія булінгу', text: 'Куди звернутися і як подати заяву', href: '/batkam/protydiia-bulinhu/' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__text">
        <span class="eyebrow">{site.tagline}</span>
        <h1>{site.fullName}</h1>
        <div class="hero__btns">
          <a class="btn btn--ghost" href={url('/pro-nas/')}>Про нас</a>
          <a class="btn btn--ghost" href={url('/kontakty/')}>Контакти</a>
          {site.contacts.facebook && <a class="btn btn--ghost" href={site.contacts.facebook} target="_blank" rel="noopener">Ми у Facebook</a>}
        </div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <figure class="photo">
      <img src={url('/uploads/shkola.jpg')} alt="Будівля Красівського ліцею восени" width="1600" height="879" />
    </figure>

    <section class="section">
      <h2>Швидкий доступ</h2>
      <div class="cards">
        {quick.map((q) => (
          <a class="card" href={url(q.href)}>
            <h3>{q.title}</h3>
            <p>{q.text}</p>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="head">
        <h2>Новини</h2>
        <a class="btn btn--ghost" href={url('/novyny/')}>Усі новини</a>
      </div>
      <div class="newsgrid">
        {news.map((n) => <NewsCard id={n.id} title={n.data.title} date={n.data.date} cover={n.data.cover} />)}
      </div>
      {news.length === 0 && <p class="muted">Новин поки немає.</p>}
    </section>

    <section class="section contact">
      <div class="contact__box">
        <h2>Зв’язатися з нами</h2>
        <p>{site.contacts.address}</p>
        <p class="contact__phone">{site.contacts.phone}</p>
        {site.contacts.phoneNote && <p class="muted contact__who">{site.contacts.phoneNote}</p>}
        <a class="btn" href={url('/kontakty/')}>Усі контакти</a>
      </div>
      <div class="contact__box contact__box--soft">
        <h3>Телефони довіри</h3>
        <ul>
          {site.hotlines.slice(0, 3).map((h) => (
            <li><b>{h.phone}</b><span>{h.name}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { background: var(--grad); }
  .hero__in { display: grid; gap: 48px; padding-block: 72px; }
  .hero__text { display: grid; gap: 20px; min-width: 0; }
  .photo { margin: 32px 0 0; }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 1600 / 879; object-fit: cover; border-radius: var(--radius); }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  @media (max-width: 900px) { .hero__in { padding-block: 48px; } }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
  .newsgrid { display: grid; gap: 32px 20px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

  .contact { grid-template-columns: 1.4fr 1fr; }
  .contact__box { background: var(--ink); color: var(--bg); border-radius: var(--radius); padding: 36px; display: grid; gap: 14px; align-content: start; }
  .contact__box .btn { background: var(--bg); color: var(--ink); border-color: var(--bg); justify-self: start; margin-top: 8px; }
  .contact__box .muted { color: color-mix(in srgb, var(--bg) 65%, var(--ink)); }
  .contact__phone { font-size: 24px; font-weight: 800; }
  .contact__who { margin-top: -10px; }
  .contact__box--soft { background: var(--bg-soft); color: var(--ink); }
  .contact__box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .contact__box li { display: grid; }
  .contact__box li b { font-size: 22px; }
  .contact__box li span { color: var(--muted); font-size: 14px; }
  @media (max-width: 800px) { .contact { grid-template-columns: 1fr; } }
</style>
