---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsCard from '../components/NewsCard.astro';
import site from '../data/site.json';
import { url } from '../lib/nav';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const quick = [
  // look: колір плитки — 'violet', 'dark' або без нього (біла)
  { title: 'Вступ до 1 класу', text: 'Документи, заява і строки зарахування', href: '/batkam/vstup-do-1-klasu/', look: 'violet' },
  { title: 'Документи закладу', text: 'Статут, ліцензії, звіти, кошторис', href: '/dokumenty/' },
  { title: 'Протидія булінгу', text: 'Куди звернутися і як подати заяву', href: '/batkam/protydiia-bulinhu/' },
  { title: 'Адміністрація', text: 'Хто за що відповідає і як зв’язатися', href: '/pro-nas/administratsiia/', look: 'dark' },
];
---
<Base>
  <section class="bento-wrap">
    <div class="wrap bento">
      <div class="tile tile--main">
        <span class="eyebrow">{site.tagline}</span>
        <h1>{site.fullName}</h1>
        <div class="hero__btns">
          <a class="btn btn--violet" href={url('/pro-nas/')}>Про нас →</a>
          <a class="btn btn--ghost" href={url('/kontakty/')}>Контакти</a>
          {site.contacts.facebook && <a class="btn btn--ghost" href={site.contacts.facebook} target="_blank" rel="noopener">Facebook</a>}
        </div>
      </div>
      <figure class="tile tile--photo">
        <img src={url('/uploads/shkola.jpg')} alt="Будівля Красівського ліцею восени" width="1600" height="879" />
      </figure>
      {quick.map((q) => (
        <a class:list={['tile', 'tile--link', q.look && `tile--${q.look}`]} href={url(q.href)}>
          <h3>{q.title}</h3>
          <p>{q.text}</p>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <div class="wrap">

    <section class="section">
      <div class="head">
        <h2>Новини</h2>
        <a class="btn btn--ghost" href={url('/novyny/')}>Усі новини</a>
      </div>
      <div class="newsgrid">
        {news.map((n) => <NewsCard id={n.id} title={n.data.title} date={n.data.date} cover={n.data.cover} />)}
      </div>
      {news.length === 0 && <p class="muted">Новин поки немає.</p>}
    </section>

    <section class="section contact">
      <div class="contact__box">
        <h2>Зв’язатися з нами</h2>
        <p>{site.contacts.address}</p>
        <p class="contact__phone">{site.contacts.phone}</p>
        {site.contacts.phoneNote && <p class="muted contact__who">{site.contacts.phoneNote}</p>}
        <a class="btn" href={url('/kontakty/')}>Усі контакти</a>
      </div>
      <div class="contact__box contact__box--soft">
        <h3>Телефони довіри</h3>
        <ul>
          {site.hotlines.slice(0, 3).map((h) => (
            <li><b>{h.phone}</b><span>{h.name}</span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .bento-wrap { background: var(--bg-soft); padding-block: 24px 40px; }
  .bento { display: grid; gap: 14px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .tile { background: var(--bg); border-radius: 28px; padding: 28px; margin: 0; min-width: 0; }
  .tile--main { grid-column: span 2; grid-row: span 2; display: grid; gap: 20px; align-content: space-between; padding: 36px; }
  .tile--main h1 { font-size: clamp(32px, 4vw, 52px); line-height: 1.05; letter-spacing: -0.02em; }
  .tile--photo { grid-column: span 2; grid-row: span 2; padding: 0; overflow: hidden; }
  .tile--photo img { width: 100%; height: 100%; min-height: 300px; object-fit: cover; }
  .tile--link { display: grid; gap: 6px; align-content: start; color: var(--ink); text-decoration: none; min-height: 170px; transition: transform .15s; }
  .tile--link:hover { transform: translateY(-3px); }
  .tile--link h3 { font-size: 20px; }
  .tile--link p { color: var(--muted); font-size: 15px; margin: 0; }
  .tile--link .arrow { margin-top: auto; font-size: 24px; line-height: 1; }
  .tile--violet { background: var(--violet-soft); color: var(--violet-ink); }
  .tile--violet p { color: var(--violet-ink); opacity: .8; }
  .tile--dark { background: var(--ink); color: var(--bg); }
  .tile--dark p { color: color-mix(in srgb, var(--bg) 75%, var(--ink)); }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 900px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile--main, .tile--photo { grid-column: 1 / -1; grid-row: auto; }
    .tile--photo img { min-height: 0; aspect-ratio: 16 / 10; }
  }
  @media (max-width: 520px) {
    .tile { padding: 22px; border-radius: 24px; }
    .tile--main { padding: 26px; }
    .tile.tile--photo { padding: 0; }
    .tile--link { min-height: 130px; padding: 20px; }
    .tile--link h3 { font-size: 17px; hyphens: auto; }
    .tile--link p { display: none; }
  }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
  .newsgrid { display: grid; gap: 32px 20px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }

  .contact { grid-template-columns: 1.4fr 1fr; }
  .contact__box { background: var(--ink); color: var(--bg); border-radius: var(--radius); padding: 36px; display: grid; gap: 14px; align-content: start; }
  .contact__box .btn { background: var(--bg); color: var(--ink); border-color: var(--bg); justify-self: start; margin-top: 8px; }
  .contact__box .muted { color: color-mix(in srgb, var(--bg) 65%, var(--ink)); }
  .contact__phone { font-size: 24px; font-weight: 800; }
  .contact__who { margin-top: -10px; }
  .contact__box--soft { background: var(--bg-soft); color: var(--ink); }
  .contact__box ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .contact__box li { display: grid; }
  .contact__box li b { font-size: 22px; }
  .contact__box li span { color: var(--muted); font-size: 14px; }
  @media (max-width: 800px) { .contact { grid-template-columns: 1fr; } }
</style>
