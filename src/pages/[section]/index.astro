---
// Сторінки розділів «Про нас» і «Батькам»: список карток зі сторінками розділу.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { sections, url } from '../../lib/nav';

export function getStaticPaths() {
  return ['pro-nas', 'batkam'].map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const meta = sections.find((s) => s.id === section)!;
const pages = (await getCollection('pages', ({ data }) => data.section === section))
  .sort((a, b) => a.data.order - b.data.order);

// Додаткові «вбудовані» сторінки, які не є markdown-файлами.
const extra = section === 'pro-nas'
  ? [{ id: 'administratsiia', title: 'Адміністрація', description: 'Директор, заступники і працівники закладу.', group: undefined, order: 20 }]
  : [];

const items = [
  ...pages.map((p) => ({ id: p.id, title: p.data.title, description: p.data.description, group: p.data.group, order: p.data.order })),
  ...extra,
].sort((a, b) => a.order - b.order);

const groups = [...new Set(items.map((i) => i.group ?? ''))];
// Плитки як на головній (сіре тло, білі плитки, перша фіолетова).
const tiles = true;
---
<Base title={meta.title} description={meta.description} current={section}>
  <PageHead title={meta.title} lead={meta.description} />
  <div class:list={[tiles && 'tiles']}>
  <div class="wrap">
    {groups.map((g, gi) => (
      <section class="section">
        {g && <h2>{g}</h2>}
        <div class="cards">
          {items.filter((i) => (i.group ?? '') === g).map((i, n) => (
            <a class:list={['card', tiles && gi === 0 && n === 0 && 'card--violet']} href={url(`/${section}/${i.id}/`)}>
              <h3>{i.title}</h3>
              {i.description && <p>{i.description}</p>}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
  </div>
</Base>

<style>
  .tiles { background: var(--bg-soft); }
  .tiles .card { background: var(--bg); border-radius: 28px; padding: 28px; min-height: 180px; transition: transform .15s; }
  .tiles .card:hover { background: var(--bg); transform: translateY(-3px); }
  .tiles .card--violet, .tiles .card--violet:hover { background: var(--violet-soft); color: var(--violet-ink); }
  .tiles .card--violet p { color: var(--violet-ink); opacity: .8; }
</style>
