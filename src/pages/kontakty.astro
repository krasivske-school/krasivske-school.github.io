---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../data/site.json';
import CopyButton from '../components/CopyButton.astro';
const c = site.contacts;
---
<Base title="Контакти" description="Адреса, телефони і телефони довіри." current="kontakty">
  <PageHead title="Контакти" lead="Як зв’язатися з нами і куди звернутися по допомогу." />
  <div class="wrap section">
    <div class="grid">
      <div class="box box--dark">
        <span class="label">Адреса</span>
        <p class="big">{c.address}</p>
        <a class="btn" href={c.mapUrl} target="_blank" rel="noopener">Відкрити на мапі</a>
      </div>
      <div class="box">
        <span class="label">Телефон</span>
        <p class="big"><a class="clink" href={`tel:${c.phone.replace(/\s/g, '')}`}>{c.phone}</a></p>
        <p class="muted">{c.phoneNote}</p>
        {c.email && (<><span class="label">E-mail</span><p class="big row"><a class="clink" href={`mailto:${c.email}`}>{c.email}</a><CopyButton text={c.email} label="Скопіювати e-mail" /></p></>)}
        {c.facebook && <p><a class="clink" href={c.facebook} target="_blank" rel="noopener">Сторінка у Facebook</a></p>}
        {site.edrpou && <p class="muted">Код ЄДРПОУ: {site.edrpou}</p>}
      </div>
    </div>

    <h2>Телефони довіри</h2>
    <div class="hot">
      {site.hotlines.map((h) => (
        <div class="box">
          <p class="big">{h.phone}</p>
          <b>{h.name}</b>
          <span class="muted">{h.note}</span>
        </div>
      ))}
    </div>

    {site.support && (
      <>
        <h2>Підтримка сайту</h2>
        <div class="box support">
          <p>Помітили помилку на сайті, неробоче посилання чи застарілу інформацію? Напишіть або зателефонуйте.</p>
          <b>{site.support.name}</b>
          {site.support.phone && <p class="big"><a class="clink" href={`tel:${site.support.phone.replace(/\s/g, '')}`}>{site.support.phone}</a></p>}
          {site.support.email && <p class="big row"><a class="clink" href={`mailto:${site.support.email}`}>{site.support.email}</a><CopyButton text={site.support.email} label="Скопіювати e-mail" /></p>}
        </div>
      </>
    )}
  </div>
</Base>

<style>
  .grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 16px; margin-bottom: 24px; }
  .box > * { min-width: 0; overflow-wrap: anywhere; }
  h2 { margin-top: 24px; }
  .hot { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .box { background: var(--bg-soft); border-radius: var(--radius); padding: 32px; display: grid; gap: 10px; align-content: start; }
  .support { max-width: 640px; }
  .box--dark { background: var(--ink); color: var(--bg); }
  .box--dark .btn { background: var(--bg); color: var(--ink); border-color: var(--bg); justify-self: start; margin-top: 8px; }
  .label { font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; opacity: .7; }
  .big { font-size: 24px; font-weight: 800; line-height: 1.3; }
  .row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  /* Посилання в контактах: колір тексту і тонке підкреслення замість синього. */
  .clink { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 30%, transparent); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .clink:hover { text-decoration-color: currentColor; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
</style>
