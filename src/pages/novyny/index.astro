---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import NewsCard from '../../components/NewsCard.astro';
import { url } from '../../lib/nav';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const extra = await getCollection('pages', ({ data }) => data.section === 'novyny');
---
<Base title="Новини" description="Новини та події закладу." current="novyny">
  <PageHead title="Новини" lead="Події, свята, змагання і досягнення учнів.">
    {extra.length > 0 && (
      <div class="links">{extra.map((p) => <a class="btn btn--ghost" href={url(`/novyny/${p.id}/`)}>{p.data.title}</a>)}</div>
    )}
  </PageHead>
  <div class="wrap section">
    <div class="grid">
      {news.map((n) => <NewsCard id={n.id} title={n.data.title} date={n.data.date} cover={n.data.cover} />)}
    </div>
  </div>
</Base>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 10px; }
  .grid { display: grid; gap: 40px 20px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
</style>
