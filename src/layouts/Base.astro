---
import '../styles/global.css';
import site from '../data/site.json';
import { sections, url } from '../lib/nav';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const { title, description = `${site.fullName} — ${site.tagline}`, current } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.fullName;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <script is:inline>
    // Застосувати збережену тему ще до показу сторінки, щоб не було блимання.
    try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Перейти до змісту</a>
  <header class="top">
    <div class="wrap top__in">
      <a class="logo" href={url('/')} aria-label={`${site.fullName} — головна`}>
        {site.logo
          ? <img class="logo__mark" src={site.logo.startsWith('/') ? url(site.logo) : site.logo} alt="" width="44" height="44" />
          : <span class="logo__mark" aria-hidden="true">{site.name.charAt(0)}</span>}
        <span class="logo__text"><b>{site.name}</b><small>Новопільської сільської ради</small></span>
      </a>
      <nav class="nav" aria-label="Головне меню">
        {sections.map((s) => (
          <a href={url(`/${s.id}/`)} aria-current={current === s.id ? 'page' : undefined}>{s.title}</a>
        ))}
      </nav>
      <div class="tools">
      <button class="theme" type="button" aria-label="Перемкнути тему" title="Світла / темна тема">
        <svg class="theme__sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <svg class="theme__moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      </button>
      <details class="burger">
        <summary aria-label="Меню"><span></span><span></span><span></span></summary>
        <nav class="burger__menu" aria-label="Мобільне меню">
          {sections.map((s) => (
            <a href={url(`/${s.id}/`)} aria-current={current === s.id ? 'page' : undefined}>{s.title}</a>
          ))}
        </nav>
      </details>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap foot__in">
      <div class="foot__col">
        <b>{site.fullName}</b>
        <span>{site.contacts.address}</span>
        {site.edrpou && <span>Код ЄДРПОУ: {site.edrpou}</span>}
      </div>
      <div class="foot__col">
        <span class="foot__phone"><span>Телефон: {site.contacts.phone}</span>{site.contacts.phoneNote && <span class="foot__who">{site.contacts.phoneNote.charAt(0).toUpperCase() + site.contacts.phoneNote.slice(1)}</span>}</span>
        {site.contacts.email && <a href={`mailto:${site.contacts.email}`}>{site.contacts.email}</a>}
        {site.contacts.facebook && <a href={site.contacts.facebook}>Facebook</a>}
        {site.support && (
          <span class="foot__phone foot__dev">
            {site.support.phone && <span>Телефон: {site.support.phone}</span>}
            <span>Розробник сайту {site.support.name}</span>
          </span>
        )}
      </div>
      <nav class="foot__col" aria-label="Нижнє меню">
        {sections.map((s) => <a href={url(`/${s.id}/`)}>{s.title}</a>)}
      </nav>
    </div>
    <div class="wrap foot__copy">© {new Date().getFullYear()} {site.fullName}</div>
  </footer>
  <button class="totop" type="button" aria-label="Вгору сторінки" title="Вгору">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <script is:inline>
    // Кнопка «вгору»: з'являється, коли прогорнули ~1,5 екрана.
    (function () {
      var btn = document.querySelector('.totop');
      if (!btn) return;
      function update() { btn.classList.toggle('totop--on', window.scrollY > window.innerHeight * 1.5); }
      window.addEventListener('scroll', update, { passive: true });
      update();
      btn.addEventListener('click', function () {
        var calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
      });
    })();
  </script>
  <script is:inline>
    (function () {
      var btn = document.querySelector('.theme');
      if (!btn) return;
      var dark = window.matchMedia('(prefers-color-scheme: dark)');
      function current() {
        return document.documentElement.dataset.theme || (dark.matches ? 'dark' : 'light');
      }
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    })();
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 16px; z-index: 100; background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 999px; }

  .top { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .top__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .logo { display: flex; align-items: center; gap: 12px; color: inherit; text-decoration: none; }
  .logo__mark { width: 44px; height: 44px; border-radius: 14px; background: var(--ink); color: var(--accent); display: grid; place-items: center; font-weight: 800; font-size: 22px; flex: none; }
  img.logo__mark { object-fit: cover; background: var(--bg-soft); box-shadow: 0 0 0 1px var(--line); }

  .tools { display: flex; align-items: center; gap: 8px; }
  .theme { width: 48px; height: 48px; border-radius: 999px; border: 0; background: var(--bg-soft); color: var(--ink); display: grid; place-items: center; cursor: pointer; flex: none; }
  .theme:hover { background: var(--line); }

  .totop {
    position: fixed; z-index: 30;
    right: max(16px, env(safe-area-inset-right)); bottom: max(20px, env(safe-area-inset-bottom));
    width: 52px; height: 52px; border-radius: 999px; border: 0;
    background: var(--ink); color: var(--bg);
    display: grid; place-items: center; cursor: pointer;
    box-shadow: 0 10px 24px -8px rgba(0,0,0,.45);
    opacity: 0; visibility: hidden; transform: translateY(12px);
    transition: opacity .2s, transform .2s, visibility .2s;
  }
  .totop--on { opacity: 1; visibility: visible; transform: none; }
  .totop:hover { opacity: .85; }
  .theme__sun { display: none; }
  :global(:root[data-theme='dark']) .theme__sun { display: block; }
  :global(:root[data-theme='dark']) .theme__moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme__sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme__moon { display: none; }
  }
  .logo__text { display: grid; line-height: 1.2; }
  .logo__text b { font-size: 17px; font-weight: 800; }
  .logo__text small { font-size: 13px; color: var(--muted); }

  .nav { display: flex; gap: 4px; }
  .nav a, .burger__menu a { color: var(--ink); text-decoration: none; font-weight: 600; font-size: 16px; padding: 10px 16px; border-radius: 999px; }
  .nav a:hover { background: var(--bg-soft); }
  .nav a[aria-current='page'], .burger__menu a[aria-current='page'] { background: var(--ink); color: var(--bg); }

  .burger { display: none; position: relative; }
  .burger summary { list-style: none; cursor: pointer; width: 48px; height: 48px; border-radius: 999px; background: var(--bg-soft); display: grid; place-content: center; gap: 5px; }
  .burger summary::-webkit-details-marker { display: none; }
  .burger summary span { display: block; width: 20px; height: 2px; background: var(--ink); border-radius: 2px; }
  .burger__menu { position: absolute; right: 0; top: 58px; background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 8px; display: grid; min-width: 220px; box-shadow: 0 20px 40px -20px rgba(0,0,0,.3); }

  @media (max-width: 900px) {
    .nav { display: none; }
    .burger { display: block; }
  }

  .foot { margin-top: 80px; background: var(--bg-soft); padding-block: 48px 32px; font-size: 15px; }
  .foot__in { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 32px 48px; }
  .foot__col { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .foot__col a { color: var(--ink); }
  .foot__phone { display: grid; }
  .foot__dev { margin-top: 8px; }
  @media (min-width: 761px) { .foot__who { white-space: nowrap; } }
  .foot__copy { margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  @media (max-width: 760px) { .foot__in { grid-template-columns: 1fr; } }
</style>
